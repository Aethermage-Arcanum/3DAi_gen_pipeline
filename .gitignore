# Python
__pycache__/
*.pyc

# Blender-Backups
*.blend1
*.blend2

# Geheimnisse (liegen eigentlich im Wurzelordner, hier nur zur Sicherheit)
.env
.env.*

# Reproduzierbare Demo-Ausgaben (neu erzeugen mit procedural/demo.py)
procedural/demo_output/

# Tripo-Downloads in creatures/*/raw/ werden BEWUSST versioniert:
# sie haben Credits gekostet und sind nicht kostenlos reproduzierbar.

# Vorschau-Renders aus inspect_model.py (reproduzierbar)
creatures/*/review/

# Rig-Ausgaben (reproduzierbar mit rigging/crawler_rig.py)
creatures/*/rig/test/
creatures/*/rig/*.blend1
creatures/*/rig/*.blend
creatures/*/rig/anim/*.png
creatures/*/rig/closeup/

# UV-Prüfung: reproduzierbare Renders/Modelle (Bericht + Übersicht bleiben)
creatures/*/uv/*.glb
creatures/*/uv/uv_*_arpg.png
creatures/*/uv/uv_*_side.png
uv/textures/biome_*.png
uv/textures/uv_checker.png
creatures/*/style_tests/*/*.blend
creatures/*/style_tests/*/output/*.blend*
creatures/*/uv/insp_*.png
creatures/*/output/*.blend1

# Arbeits-/Testordner (Regressions-Neubauten, Vergleichsstände)
temp/
# Bau-Nachweis + Fingerabdruck im rig/ sind reproduzierbar; versioniert wird nur approved/
creatures/*/rig/build_manifest.json
creatures/*/rig/fingerprint.json.gz
creatures/*/style_tests/*/build_manifest.json
creatures/*/style_tests/*/fingerprint.json.gz
